rules_version = '2';

// ============================================
// FIRESTORE SECURITY RULES
// Visa Aylin Consultancy - Qatar Job Hunt Tracker
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Trackers: one document per user, keyed by their auth UID
    match /trackers/{userId} {

      // READ: Any signed-in user can read all trackers.
      // This is needed for the admin dashboard to work.
      // For small trusted groups this is acceptable.
      allow read: if request.auth != null;

      // WRITE: Users can only write to their own tracker document.
      // The document ID MUST match their authenticated user ID.
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
